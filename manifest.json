{
  "manifest_version": 3,
  "name": "Archery 助手",
  "version": "1.2.0",
  "minimum_chrome_version": "120",
  "description": "Archery SQL 工作台：数据库对象浏览、多次查询结果保留、SQL 审核检测、工单查询与数据导出。",
  "permissions": [
    "storage",
    "cookies",
    "tabs",
    "declarativeNetRequest",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "Archery 助手",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "sw.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}